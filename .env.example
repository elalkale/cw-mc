# ────────────────────────────────────────────────────────────
# Configuración del Panel Minecraft
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.
# ────────────────────────────────────────────────────────────

# Puerto del backend
PORT=4000

# URL del frontend (para CORS)
# En desarrollo: http://localhost:5173
# En producción: https://tu-dominio.com
CORS_ORIGIN=http://localhost:5173

# Secreto JWT — usa una cadena aleatoria larga y segura en producción
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_SEGURO

# Credenciales de acceso al panel
ADMIN_USER=admin
ADMIN_PASS=CAMBIA_ESTA_CONTRASEÑA

# Token de la API de CurseForge (obtén uno en https://console.curseforge.com)
# Déjalo vacío si no usas el catálogo de mods
CURSEFORGE_API_TOKEN=
